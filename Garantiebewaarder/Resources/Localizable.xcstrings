    "claim.mail.request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'd like to ask you to look into this and let me know within a reasonable time how we can resolve it. I have the receipt at hand and am happy to send it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik wil je vragen hier naar te kijken en mij binnen een redelijke termijn te laten weten hoe we dit oplossen. De bon heb ik bij de hand en stuur ik graag mee."
          }
        }
      }
    },
