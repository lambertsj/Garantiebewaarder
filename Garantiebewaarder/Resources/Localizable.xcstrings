    "legal.claim.1.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the end date in the app. Many products come with two years of warranty by default; the actual term depends on the product and your situation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk naar de einddatum in de app. Veel producten hebben standaard twee jaar garantie; de werkelijke termijn hangt af van het product en je situatie."
          }
        }
      }
    },
    "legal.claim.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether you're still covered"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of je nog garantie hebt"
          }
        }
      }
    },
    "legal.claim.2.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the receipt or invoice, take photos or a video of the problem and note the serial number. It's all in the app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek de bon of factuur erbij, maak foto's of een filmpje van het probleem en noteer het serienummer. Alles staat in de app."
          }
        }
      }
    },
    "legal.claim.2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather your receipt and evidence"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzamel je bon en bewijs"
          }
        }
      }
    },
    "legal.claim.3.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually start with the store where you bought the product, not necessarily the manufacturer. An email shows what you asked and when."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin meestal bij de winkel waar je het product kocht, en niet per se bij de fabrikant. Een e-mail laat zien wat je hebt gevraagd en wanneer."
          }
        }
      }
    },
    "legal.claim.3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact the seller"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem contact op met de verkoper"
          }
        }
      }
    },
    "legal.claim.4.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain briefly and clearly what's wrong, what you'd like (for example a repair) and give the seller a reasonable time to respond."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg kort en duidelijk uit wat er mis is, wat je wilt (bijvoorbeeld herstel) en geef de verkoper een redelijke termijn om te reageren."
          }
        }
      }
    },
    "legal.claim.4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the problem and allow a reasonable time"
