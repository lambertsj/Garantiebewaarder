    "claim.mail.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the text before sending. The app never sends anything itself. Attach the receipt by sharing the product."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de tekst aan voordat je hem verstuurt. De app verstuurt zelf niets. Voeg de bon toe als bijlage via het delen van het product."
          }
        }
      }
    },
