    "legal.defaultTerm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many products come with two years of warranty by default; the actual term depends on the product and your situation. This is a setting, not a legal claim. General information, not legal advice. See consuwijzer.nl for current rules."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel producten hebben standaard twee jaar garantie; de werkelijke termijn hangt af van het product en je situatie. Dit is een instelling, geen juridische bewering. Algemene informatie, geen juridisch advies. Kijk voor de actuele regels op consuwijzer.nl."
          }
        }
      }
    },
