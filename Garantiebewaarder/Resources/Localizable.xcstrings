    "primer.title": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneren aan je garantie?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind you about your warranty?"
          }
        }
      }
    },
    "primer.message": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We kunnen je een melding sturen voordat de garantie van een product afloopt, zodat je het nog kunt laten controleren. De meldingen komen alleen van je eigen toestel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can send you a reminder before a product's warranty ends, so you can still have it checked. Reminders come from your own device only."
          }
        }
      }
    },
    "primer.accept": {
      "localizations": {
