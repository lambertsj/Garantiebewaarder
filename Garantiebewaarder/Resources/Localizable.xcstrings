    "settings.iCloud.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Your data then goes to your own private iCloud storage so it's also on your other devices. We have no server and can't see your data. A change takes effect after restarting the app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Je gegevens gaan dan naar je eigen, privé iCloud-opslag, zodat ze ook op je andere toestellen staan. Wij hebben geen server en kunnen je gegevens niet zien. Een wijziging werkt na het opnieuw opstarten van de app."
          }
        }
      }
    },
