    "onboarding.1.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a receipt or pick a photo or PDF. The app reads the details for you and tracks when the warranty ends."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een bon of kies een foto of PDF. De app leest de gegevens voor je en houdt bij wanneer de garantie afloopt."
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your receipts in one place"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je bonnen op één plek"
          }
        }
      }
    },
    "onboarding.2.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on your own device. No account, no ads, no tracking. If you like, you can sync via your own iCloud later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens blijven op je eigen toestel. Geen account, geen advertenties, geen tracking. Als je wilt kun je later synchroniseren via je eigen iCloud."
          }
        }
      }
    },
    "onboarding.2.title": {
