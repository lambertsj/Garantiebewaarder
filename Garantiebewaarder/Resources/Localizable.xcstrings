    "settings.iCloud": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer via iCloud"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync via iCloud"
          }
        }
      }
    },
    "settings.iCloud.footer": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Je gegevens gaan dan naar je eigen, privé iCloud-opslag, zodat ze ook op je andere toestellen staan. Wij hebben geen server en kunnen je gegevens niet zien. Een wijziging werkt na het opnieuw opstarten van de app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Your data then goes to your own private iCloud storage so it's also on your other devices. We have no server and can't see your data. A change takes effect after restarting the app."
          }
        }
      }
    },
    "settings.iCloud.restartOn": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app helemaal af en open hem opnieuw om synchronisatie te starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully close and reopen the app to start syncing."
          }
        }
      }
    },
    "settings.iCloud.restartOff": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app helemaal af en open hem opnieuw om synchronisatie te stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fully close and reopen the app to stop syncing."
          }
        }
      }
    },
    "settings.iCloud.fellBack": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten. De app werkt gewoon lokaal door; controleer je iCloud-instellingen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing couldn't start. The app keeps working locally; check your iCloud settings."
          }
        }
      }
    },
