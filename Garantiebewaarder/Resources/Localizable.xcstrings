    "legal.claim.5.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ConsuWijzer has information about your options. In a dispute, a dispute committee may be an option. Check there for current rules."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op ConsuWijzer vind je informatie over je mogelijkheden. Bij een geschil kan een geschillencommissie een optie zijn. Kijk daar voor de actuele regels."
          }
        }
      }
    },
    "legal.claim.5.title": {
      "localizations": {
