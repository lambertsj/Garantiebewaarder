{
  "sourceLanguage": "nl",
  "strings": {
    "%lld": {},
    "about.feedback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send feedback or report a problem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback of een probleem melden"
          }
        }
      }
    },
    "about.feedback.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens GitHub in Safari, where you can leave a message. No email address or account in the app is needed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent GitHub in Safari. Daar kun je een bericht achterlaten; er is geen e-mailadres of account in de app nodig."
          }
        }
      }
    },
    "about.free": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a free hobby project, not commercial: no subscription, no purchases and no limit on the number of products."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een gratis hobbyproject, niet commercieel: geen abonnement, geen aankopen en geen limiet op het aantal producten."
          }
        }
      }
    },
    "about.privacy.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your data stays on your own device. There's no account and no server of ours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je gegevens blijven op je eigen toestel. Er is geen account en geen eigen server."
          }
        }
      }
    },
    "about.privacy.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing via iCloud is optional and goes to your own private iCloud storage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseren via iCloud is optioneel en gaat naar je eigen, privé iCloud-opslag."
          }
        }
      }
    },
    "about.privacy.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tracking, no ads and no third-party analytics."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tracking, geen advertenties en geen analyse-diensten van anderen."
          }
        }
      }
    },
    "about.privacy.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text on receipts is recognized on your device. Photos and text are never sent anywhere unless you share or export them yourself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst op bonnen wordt op je toestel herkend. Foto's en tekst worden niet verstuurd, behalve als jij zelf deelt of exporteert."
          }
        }
      }
    },
    "about.privacy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your privacy"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw privacy"
          }
        }
      }
    },
